{
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -r -f *)",
      "Bash(sudo rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(gh auth token*)",
      "Bash(gh secret *)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit*)",
      "Bash(gh label delete*)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "Edit(**/.claude/hooks/**)",
      "Edit(**/.claude/state/**)",
      "Edit(**/scripts/screen-ticket.js)",
      "Edit(**/scripts/ticket-guard/**)",
      "Edit(**/.github/workflows/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-dangerous.js\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ticket-gate.js\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-prompts.js\" 2>/dev/null; bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-commit-push.sh\" 2>/dev/null || true",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
